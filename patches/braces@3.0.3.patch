diff --git a/lib/guard.js b/lib/guard.js
new file mode 100644
index 0000000000000000000000000000000000000000..398114d251abb4e4fbcbc5134bc1fcc50c6f03f2
--- /dev/null
+++ b/lib/guard.js
@@ -0,0 +1,16 @@
+'use strict';
+
+// Validate iteratively before any recursive AST walker is entered.
+module.exports = ast => {
+  const pending = [[ast, 0]];
+  let visited = 0;
+  while (pending.length > 0) {
+    const [node, depth] = pending.pop();
+    if (depth > 128 || ++visited > 65536) {
+      throw new RangeError('Brace AST exceeds safe nesting or node limit');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) pending.push([child, depth + 1]);
+    }
+  }
+};
